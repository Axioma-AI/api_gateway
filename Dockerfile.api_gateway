# Multi-stage build para optimizar el tamaño final
FROM python:3.12-slim as builder

# Instalar dependencias de compilación
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Crear directorio para las dependencias
WORKDIR /wheels

# Copiar solo requirements.txt para aprovechar cache de Docker
COPY requirements.txt .

# Crear wheels de las dependencias para instalación más rápida
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /wheels -r requirements.txt

# Etapa final - imagen de producción
FROM python:3.12-slim

# Metadatos de la imagen
LABEL maintainer="API Gateway Team" \
      version="1.0" \
      description="FastAPI Gateway for microservices"

# Variables de entorno para optimización
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Crear usuario no-root desde el inicio
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Establecer directorio de trabajo
WORKDIR /app

# Copiar wheels desde la etapa builder
COPY --from=builder /wheels /wheels
COPY requirements.txt .

# Instalar dependencias desde wheels (más rápido)
RUN pip install --no-index --find-links /wheels -r requirements.txt \
    && rm -rf /wheels requirements.txt

# Instalar curl para healthcheck
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copiar código de la aplicación
COPY --chown=appuser:appuser . .

# Crear directorio de logs con permisos correctos
RUN mkdir -p logs && chown -R appuser:appuser logs

# Cambiar a usuario no-root
USER appuser
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:51010/docs || exit 1

# Exponer puerto
EXPOSE 51010

# Comando optimizado para producción
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "51010"]
